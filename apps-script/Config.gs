/** Секретний ключ для доступу до doGet. Зберігається у властивостях скрипта, не в коді. */
function getSecret_() {
  var p = PropertiesService.getScriptProperties();
  var s = p.getProperty('API_KEY');
  if (!s) { s = Utilities.getUuid(); p.setProperty('API_KEY', s); }
  return s;
}

/** Запустити один раз вручну, щоб побачити ключ — його треба вписати у змінні Vercel. */
function showApiKey() {
  Logger.log('API_KEY: ' + getSecret_());
}
